---
import { ArrowRight } from '@lucide/astro';
import { finalCta } from '../data/content';
---

<section class="relative overflow-hidden bg-gold py-16 text-ink sm:py-24" data-sticky-cta-hide>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgb(255_255_255/0.45),transparent_60%)]"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6">
    <div data-line class="mx-auto h-1 w-2/3 max-w-md origin-center rounded-full bg-navy" aria-hidden="true"></div>
    <h2 data-reveal class="mt-10 font-sans text-2xl leading-snug font-extrabold sm:text-4xl">
      {finalCta.title}
    </h2>
    <div class="mt-10" data-reveal data-reveal-delay="0.1">
      <a
        href="#agenda"
        class="group relative inline-flex w-full items-center justify-center gap-3 overflow-hidden rounded-2xl bg-navy px-8 py-5 font-display text-lg font-bold text-white uppercase italic shadow-[0_20px_50px_-20px_rgb(18_54_100/0.8)] transition-[transform,background-color] duration-300 ease-out-expo hover:-translate-y-0.5 hover:bg-navy-800 sm:w-auto sm:px-16 sm:text-2xl"
      >
        {finalCta.cta}
        <ArrowRight class="size-6 text-gold transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
