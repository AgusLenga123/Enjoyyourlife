---
import { ArrowRight, Quote, TrendingUp } from '@lucide/astro';
import { testimonials } from '../data/content';
import VideoFacade from './VideoFacade.astro';
---

<section id="casos" class="relative isolate overflow-hidden py-20 sm:py-28" data-sticky-cta-trigger>
  <div class="grid-bg absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
  <div
    class="absolute top-1/3 -left-60 -z-10 size-[40rem] rounded-full bg-navy-500/30 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <p class="eyebrow text-gold" data-reveal>{testimonials.eyebrow}</p>
    <h2
      data-reveal
      class="mt-5 text-center text-3xl leading-tight font-bold tracking-tight sm:text-5xl lg:text-6xl"
    >
      {testimonials.title}
    </h2>
    <p
      data-reveal
      data-reveal-delay="0.1"
      class="mx-auto mt-5 max-w-3xl text-center font-display text-lg leading-snug font-semibold text-gold sm:text-2xl"
    >
      {testimonials.subtitle}
    </p>

    <ol class="mt-12 space-y-6 sm:mt-16 sm:space-y-8">
      {
        testimonials.items.map((t, i) => (
          <li
            data-reveal
            class="spotlight group grid overflow-hidden rounded-3xl border border-white/10 bg-navy-950/60 shadow-[0_30px_80px_-40px_rgb(0_0_0/0.8)] backdrop-blur-sm transition-colors duration-500 hover:border-gold/30 lg:grid-cols-[minmax(0,26rem)_1fr]"
          >
            {/* Video slot: set `video` for each item in src/data/content.ts */}
            <div class="relative flex items-center overflow-hidden bg-linear-to-br from-navy-600 via-navy to-navy-950 p-4 sm:p-6">
              <div data-parallax class="absolute inset-0 grid-bg opacity-70" aria-hidden="true" />
              <div class="absolute -right-10 -bottom-10 size-40 rounded-full bg-gold/20 blur-2xl transition-transform duration-700 group-hover:scale-150" aria-hidden="true" />
              <VideoFacade
                url={t.video}
                size="sm"
                class="w-full"
                title={`Caso de éxito #${i + 1} — ${t.author}`}
                label="Ver testimonio"
                pendingLabel="Video testimonio — próximamente"
              >
                <span class="absolute top-3 left-3 rounded-lg bg-navy-950/70 px-2.5 py-1 font-display text-sm font-bold text-gold ring-1 ring-gold/30 backdrop-blur-sm">
                  #{i + 1}
                </span>
              </VideoFacade>
            </div>

            <figure class="grid gap-6 p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:gap-10 lg:p-10">
              <div>
                <Quote class="size-8 text-gold/60" aria-hidden="true" />
                <blockquote class="mt-3 font-display text-xl leading-snug font-semibold text-white sm:text-2xl">
                  “{t.quote}”
                </blockquote>
                <p class="mt-4 text-[15px] leading-relaxed text-white/65 sm:text-base">{t.body}</p>
                <figcaption class="mt-6 flex items-center gap-3 text-sm font-semibold text-white/80">
                  <span class="h-px w-6 bg-gold" aria-hidden="true" />
                  {t.author}
                </figcaption>
              </div>

              <div class="flex items-start gap-3 rounded-2xl border border-gold/20 bg-gold/[0.06] p-5 lg:w-56 lg:flex-col lg:self-center lg:rounded-none lg:border-0 lg:border-l lg:border-white/15 lg:bg-transparent lg:p-0 lg:pl-8">
                <TrendingUp class="size-6 shrink-0 text-gold" aria-hidden="true" />
                <p class="font-display text-[17px] leading-snug font-semibold text-gold">
                  <span class="text-gold/70">{t.from}</span> {t.to}
                </p>
              </div>
            </figure>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 text-center sm:mt-16" data-reveal>
      <a href="#agenda" class="btn-gold w-full sm:w-auto">
        {testimonials.cta}
        <ArrowRight class="arrow size-5" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
