---
import { Sparkles } from '@lucide/astro';
import { marquee } from '../data/content';

// Duplicated once so the -50% translate loops seamlessly
const items = [...marquee, ...marquee];
---

<div
  class="relative overflow-hidden border-y border-gold/20 bg-navy-900 py-4 sm:py-5"
  aria-label="Situaciones que entrenamos"
>
  <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-linear-to-r from-navy-900 to-transparent sm:w-40" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-linear-to-l from-navy-900 to-transparent sm:w-40" aria-hidden="true"></div>
  <ul class="animate-marquee flex w-max items-center hover:[animation-play-state:paused]">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-6 px-3 font-display text-lg font-semibold whitespace-nowrap text-white/80 italic sm:gap-10 sm:px-5 sm:text-2xl" aria-hidden={i >= marquee.length ? 'true' : undefined}>
          {item}
          <Sparkles class="size-4 text-gold sm:size-5" aria-hidden="true" />
        </li>
      ))
    }
  </ul>
</div>
