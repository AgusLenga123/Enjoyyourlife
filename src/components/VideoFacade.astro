---
import { Image } from 'astro:assets';
import { Play } from '@lucide/astro';
import logo from '../assets/logo.png';
import { videoEmbed } from '../lib/embeds';

interface Props {
  url?: string;
  /** Accessible title for the player */
  title: string;
  /** Caption under the play button */
  label: string;
  /** Caption when there is no video yet */
  pendingLabel: string;
  size?: 'lg' | 'sm';
  class?: string;
}

const { url, title, label, pendingLabel, size = 'lg', class: className } = Astro.props;
const video = videoEmbed(url);
const lg = size === 'lg';
---

<!--
  Click-to-load video: nothing is requested from YouTube/Vimeo until the visitor
  presses play. The player itself is injected by src/scripts/main.ts.
-->
<div
  class:list={[
    'relative aspect-video overflow-hidden border border-gold/30 bg-navy-950 ring-1 ring-white/5',
    lg ? 'rounded-2xl shadow-[0_40px_120px_-30px_rgb(0_0_0/0.7)] sm:rounded-3xl' : 'rounded-2xl',
    className,
  ]}
  data-video
  data-provider={video?.provider}
  data-src={video?.src}
  data-title={title}
>
  <button
    type="button"
    data-video-play
    class="group absolute inset-0 flex h-full w-full cursor-pointer flex-col items-center justify-center gap-3 overflow-hidden text-center disabled:cursor-default sm:gap-4"
    aria-label={video ? `Reproducir: ${title}` : pendingLabel}
    disabled={!video}
  >
    <span class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,var(--color-navy-600),var(--color-navy-950)_70%)]" aria-hidden="true"></span>
    <span class="grid-bg absolute inset-0 opacity-60" aria-hidden="true"></span>
    <Image
      src={logo}
      alt=""
      width={340}
      height={290}
      class="pointer-events-none absolute top-1/2 left-1/2 w-[38%] -translate-x-1/2 -translate-y-1/2 opacity-[0.07] transition-transform duration-[1.2s] ease-out-expo group-hover:scale-110"
    />
    <slot />

    <span class:list={['relative grid place-items-center', lg ? 'size-16 sm:size-24' : 'size-14']}>
      {video && <span class="absolute inset-0 animate-ping rounded-full bg-gold/30 [animation-duration:2.4s]" aria-hidden="true" />}
      <span
        class:list={[
          'relative grid size-full place-items-center rounded-full text-navy transition-transform duration-500 ease-out-expo',
          video ? 'bg-gold shadow-[0_0_60px_-5px_rgb(216_188_138/0.8)] group-hover:scale-110' : 'bg-gold/60',
        ]}
      >
        <Play class:list={['ml-1 fill-current', lg ? 'size-7 sm:size-10' : 'size-6']} aria-hidden="true" />
      </span>
    </span>
    <span class:list={['relative px-4 font-display font-semibold tracking-wide text-white/80', lg ? 'text-sm sm:text-base' : 'text-sm']}>
      {video ? label : pendingLabel}
    </span>
  </button>
</div>
