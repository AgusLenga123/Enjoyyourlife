---
import { Plus } from '@lucide/astro';
import { faq } from '../data/content';

// Two columns on desktop, preserving the design's left/right split
const half = Math.ceil(faq.items.length / 2);
const columns = [faq.items.slice(0, half), faq.items.slice(half)];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') },
  })),
});
---

<section id="preguntas" class="relative bg-cream py-20 text-ink sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <p class="eyebrow text-navy" data-reveal>{faq.eyebrow}</p>
    <h2 data-reveal class="mt-5 text-center text-3xl font-bold tracking-tight text-navy sm:text-5xl lg:text-6xl">
      {faq.title}
    </h2>

    <div class="mt-10 grid gap-3 rounded-3xl bg-paper p-3 sm:mt-14 sm:p-4 lg:grid-cols-2 lg:gap-4">
      {
        columns.map((col, c) => (
          <div class="space-y-3 lg:space-y-4">
            {col.map((item, i) => (
              <details
                name="faq"
                class="faq group rounded-2xl border border-navy/5 bg-white shadow-[0_2px_10px_-4px_rgb(18_54_100/0.12)] transition-[box-shadow,border-color] duration-300 open:border-gold/50 open:shadow-[0_20px_40px_-20px_rgb(18_54_100/0.3)] hover:border-gold/40"
                data-reveal
                data-reveal-delay={(c * half + i) * 0.04}
              >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left font-display text-[15px] font-semibold text-ink select-none sm:px-6 sm:py-5 sm:text-base">
                  <span>{item.q}</span>
                  <span class="grid size-8 shrink-0 place-items-center rounded-full bg-paper text-navy transition-[transform,background-color,color] duration-500 ease-out-expo group-open:rotate-[135deg] group-open:bg-navy group-open:text-gold">
                    <Plus class="size-4" aria-hidden="true" stroke-width={2.5} />
                  </span>
                </summary>
                <div class="space-y-3 px-5 pb-5 text-[15px] leading-relaxed text-ink/70 sm:px-6 sm:pb-6 sm:text-base">
                  {item.a.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={jsonLd} />
</section>
