---
import { whatsappUrl } from '../lib/contact';
import WhatsAppIcon from './WhatsAppIcon.astro';
---

<!-- Floating WhatsApp button; lifts above the sticky CTA bar on small screens (see global.css) -->
<a
  id="wa-float"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribinos por WhatsApp"
  class="group fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-30 grid size-12 place-items-center rounded-full bg-[#25D366] text-white shadow-[0_12px_30px_-8px_rgb(37_211_102/0.7)] transition-[transform,translate] duration-500 ease-out-expo hover:scale-110 sm:right-6 sm:bottom-6 sm:size-16"
>
  <span class="absolute inset-0 animate-ping rounded-full bg-[#25D366]/40 [animation-duration:3s]" aria-hidden="true"></span>
  <WhatsAppIcon class="relative size-6 sm:size-8" />
  <span
    class="pointer-events-none absolute right-full mr-3 hidden rounded-xl bg-white px-3 py-2 text-sm font-semibold whitespace-nowrap text-ink opacity-0 shadow-lg transition-opacity duration-300 group-hover:opacity-100 sm:block"
    >¿Dudas? Escribinos</span
  >
</a>
